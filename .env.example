# Copy to .env (gitignored). Never commit real values.
HELIUS_API_KEY=
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=$HELIUS_API_KEY
MAGICBLOCK_TEE_RPC=https://devnet-tee.magicblock.app
MAGICBLOCK_PAYMENTS_API=https://payments.magicblock.app
MAGICBLOCK_CLUSTER=devnet
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
AURORA_API_KEY=
FUNDING=
MAINNET_ENABLED=false
DEMO_CONFIRM=
# `pnpm fund` (task 8.3, mainnet only, off unless FUNDING=aurora, MAINNET_ENABLED=true and
# --confirm equals DEMO_CONFIRM). FUND_MAX_USDC caps --amount (default 5). FUND_REFUND_TO is the
# default --refund-to (the operator's wallet on the origin chain). MAINNET_BUYER_KEYPAIR is the
# recipient when --to is not given (default keys/mainnet/buyer.json; only the public half is read).
FUND_MAX_USDC=
FUND_REFUND_TO=
MAINNET_BUYER_KEYPAIR=
# Optional. `pnpm leak:index` (task 11.3) reads the mainnet payment-channels program read-only
# through https://mainnet.helius-rpc.com with HELIUS_API_KEY (or LEAK_RPC_URL, another mainnet
# RPC); no keypair, nothing spent. LEAK_MAX_SIGNATURES caps the signatures paged (default 20000),
# LEAK_SINCE (ISO date) stops paging at older block times, LEAK_CONCURRENCY is requests in flight (8),
# LEAK_RPS is requests started per second (5, what the Helius free plan sustains; a 429 holds every worker back).
LEAK_RPC_URL=
LEAK_MAX_SIGNATURES=
LEAK_SINCE=
LEAK_CONCURRENCY=
LEAK_RPS=

# Optional. Runs the Redis store contract tests; a local server only, nothing is flushed.
# When set, the facilitator uses Redis stores instead of memory.
REDIS_URL=
# Optional. The facilitator listens on 127.0.0.1:FACILITATOR_PORT (default 4020).
FACILITATOR_PORT=
# Optional. Rate limits as "<limit>/<seconds>" or "off": per caller address (default 300/60)
# and per channel (default 120/60). FACILITATOR_TRUST_PROXY=true reads the first
# X-Forwarded-For entry as the caller's address (only behind a proxy you run).
# FACILITATOR_LOG_LEVEL: pino level for the JSON log on stdout (default info).
FACILITATOR_RATE_IP=
FACILITATOR_RATE_CHANNEL=
FACILITATOR_TRUST_PROXY=
FACILITATOR_LOG_LEVEL=
# Redemption worker (task 7.2). REDEEM_INTERVAL in seconds between runs (default 60 for the
# demo; run 3600 in production) or "off" for admin-triggered runs only. FACILITATOR_ADMIN_TOKEN
# (16+ chars) protects POST /admin/redeem, GET /admin/alerts and GET /admin/channels, which answer loopback only;
# unset, those routes are disabled. FACILITATOR_RECEIPT_TOKENS protects GET /receipts/:channelId:
# "<vendor base58>=<token of 16+ chars>" entries separated by commas, one per vendor.
# `pnpm tokens` fills both in (after `pnpm keys`); `pnpm tokens --rotate` replaces them.
# MAX_IDLE_SECS: seconds without activity before the worker idle-closes an open channel (default 604800,
# seven days; the same value /supported advertises as extra.maxIdleSecs). POST /admin/close runs one close pass.
REDEEM_INTERVAL=
MAX_IDLE_SECS=
FACILITATOR_ADMIN_TOKEN=
FACILITATOR_RECEIPT_TOKENS=
# Optional. `pnpm vendors`: where the three vendors reach the facilitator (default
# http://127.0.0.1:4020), their ports (default 4021, 4022, 4023) and the seed of their data.
FACILITATOR_URL=
VENDOR1_PORT=
VENDOR2_PORT=
VENDOR3_PORT=
VENDORS_SEED=

# Optional. The MCP server (`pnpm --filter @wakeless/mcp-server start`): where it reaches the
# vendors (default http://127.0.0.1:VENDORn_PORT), its starting caps in USDC (default 0.05 per
# payment and 1 per rolling 24 h; caps set through set_limits persist in the budget file and
# win), its ledger and channel files (default ~/.wakeless/mcp-budget.json, ~/.wakeless/channels.json).
VENDOR1_URL=
VENDOR2_URL=
VENDOR3_URL=
WAKELESS_PER_PAYMENT_USDC=
WAKELESS_PER_DAY_USDC=
WAKELESS_BUDGET_FILE=
WAKELESS_CHANNEL_STORE=

# Keypair paths, relative to the repo root. `pnpm keys` generates these.
BUYER_KEYPAIR=keys/buyer.json
ESCROW_KEYPAIR=keys/escrow.json
VENDOR1_KEYPAIR=keys/vendor1.json
VENDOR2_KEYPAIR=keys/vendor2.json
VENDOR3_KEYPAIR=keys/vendor3.json
# The facilitator's receipt signer: signs off-chain receipts, holds no funds.
FACILITATOR_KEYPAIR=keys/facilitator.json
