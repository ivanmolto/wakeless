{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["development"]
  },
  "include": [
    "vitest*.ts",
    "scripts/**/*.ts",
    "docs/test/**/*.ts",
    "eslint/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "vendor"]
}
