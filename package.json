{
  "name": "wakeless",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "vitest run",
    "test:devnet": "vitest run --config vitest.devnet.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts",
    "e2e": "tsx --conditions=development scripts/e2e.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "keys": "tsx scripts/keys.ts",
    "tokens": "tsx scripts/tokens.ts",
    "airdrop": "tsx scripts/airdrop.ts",
    "fund:private": "tsx scripts/fund-private.ts",
    "vendors": "pnpm --filter @wakeless/vendors start",
    "vendor:receipts": "tsx --conditions=development scripts/vendor-receipts.ts",
    "client:20": "tsx --conditions=development scripts/client-20.ts",
    "agent-run": "tsx --conditions=development scripts/agent-run.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
