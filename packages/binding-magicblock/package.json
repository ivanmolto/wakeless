{
  "name": "@wakeless/binding-magicblock",
  "version": "0.1.0-alpha.0",
  "description": "SettlementBinding over MagicBlock's Private Payments API and Private Ephemeral Rollup. Devnet alpha, unaudited.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "node ../../scripts/release-guard.mjs"
  },
  "dependencies": {
    "@magicblock-labs/ephemeral-rollups-kit": "0.17.3",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0"
  },
  "peerDependencies": {
    "@wakeless/binding": "workspace:0.1.0-alpha.0"
  },
  "devDependencies": {
    "@wakeless/binding": "workspace:0.1.0-alpha.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3"
  }
}
