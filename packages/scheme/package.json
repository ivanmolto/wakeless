{
  "name": "@wakeless/scheme",
  "version": "0.1.0-alpha.0",
  "description": "x402 batch-settlement-shielded: types, voucher bytes, channel id, watermark. Pure functions, no network. Devnet alpha, unaudited.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "node ../../scripts/release-guard.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "5.9.3"
  }
}
