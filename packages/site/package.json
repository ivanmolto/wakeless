{
  "name": "@wakeless/site",
  "version": "0.0.0",
  "description": "The Wakeless docs site: Fumadocs on Next.js, every page copied at build time from the README, docs/ and the package READMEs. Devnet alpha, unaudited.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync": "tsx scripts/sync-content.ts",
    "site:dev": "tsx scripts/sync-content.ts && next dev",
    "site:build": "tsx scripts/sync-content.ts && next build",
    "site:start": "next start"
  },
  "dependencies": {
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mdast-util-to-string": "4.0.0",
    "postcss": "8.5.32",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "zbsearch": "4.0.2"
  }
